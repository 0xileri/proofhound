# Copy to .env for local runs; set these as environment variables when deployed.

# The agent's Base wallet, which signs and pays for attestations. `npm run chain:setup` creates it.
AGENT_WALLET_PRIVATE_KEY=
# BASE_RPC_URL=https://mainnet.base.org

# Web app
# PORT=3000
# PUBLIC_URL=http://localhost:3000
# Bearer token for POST /api/agent/run (starts a watch run now)
ADMIN_TOKEN=
# REPO_URL=

# Schedule. Set AGENT_SCHEDULE=off to disable it (local dev).
# AGENT_SCHEDULE=on
# WATCH_INTERVAL_HOURS=6
# BALANCE_CHECK_MINUTES=60

# Spend policy
# RUN_BUDGET_USD=0.25
# MAX_VERDICT_USD=0.05
# ROTATE_EVERY_VERDICTS=1
# MAX_VERDICTS_PER_RUN=10
# VERDICT_MODEL=anthropic/claude-sonnet-5

# Matching thresholds
# SENTENCE_MATCH=0.8
# COVERAGE_THRESHOLD=0.3
# VERBATIM_THRESHOLD=0.15

# Where state lives (a mounted volume when deployed)
# DATA_DIR=data
# ORBIO_STATE_DIR=.orbio
# ORBIO_MCP_URL=https://www.orbio.so/api/mcp
